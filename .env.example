# Copy to .env and fill in real values.
# Run `npm run setup:check` to validate.

# ── Twilio credentials ─────────────────────────────────────────────────────
# From the Twilio Console (https://console.twilio.com) — main account SID + auth token.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# ── Twilio Agent Connect ───────────────────────────────────────────────────
# Provisioned via the Twilio Console or the Python setup wizard.
# See docs/EP1_MEMORY.md for step-by-step provisioning.
TAC_MEMORY_STORE_SID=MSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAC_CONVERSATION_CONFIGURATION_SID=CFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS URL of your running agent (e.g. from `ngrok http 3001`).
# Twilio hits this for webhooks + WebSocket streaming.
TAC_PUBLIC_URL=https://your-tunnel.ngrok-free.app

# ── LLM provider ───────────────────────────────────────────────────────────
# Pick one: anthropic | openai | gemini | ollama | lmstudio
# Only the block for your chosen provider needs to be filled in.
LLM_PROVIDER=anthropic

# Anthropic (Claude) — supports prompt caching on the system prompt
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (GPT)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Google Gemini — via its OpenAI-compatible endpoint (default URL shown)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama (local). Install: https://ollama.com — then `ollama pull llama3.2`
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# LM Studio (local). Enable "OpenAI-compatible server" in LM Studio settings.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=llama3.2

# ── Agent runtime ──────────────────────────────────────────────────────────
AGENT_PORT=3001
# Where the agent writes the observability event log the dashboard tails.
# Set to empty to disable file logging.
AGENT_EVENT_LOG=./data/events.jsonl

# ── Dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
# Set to "demo" to render fixtures; "live" to tail AGENT_EVENT_LOG.
DASHBOARD_MODE=demo

# ── Agent tools (opt-in) ───────────────────────────────────────────────────
# Human handoff via Twilio Studio Flow. Set a Studio Flow SID to enable.
TWILIO_STUDIO_HANDOFF_FLOW_SID=

# Knowledge-base / RAG tool via TAC's KnowledgeClient. Provision a Knowledge
# Base in the Twilio Console and paste its SID here to expose it to the LLM.
TAC_KNOWLEDGE_BASE_ID=

# Memory retrieval-on-demand tool — lets the LLM ask for extra memory context
# mid-turn beyond what the initial Recall returned. Set to 1 to enable.
TAC_ENABLE_MEMORY_RETRIEVAL_TOOL=
